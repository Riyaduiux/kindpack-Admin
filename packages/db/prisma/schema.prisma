// Database schema (MySQL 8).
// Status/role fields are plain strings (documented values in comments) so new states
// don't need a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  avatarUrl    String?   @db.VarChar(500)
  /// ADMIN | USER
  role         String    @default("USER")
  /// ACTIVE | SUSPENDED
  status       String    @default("ACTIVE")
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens RefreshToken[]
  uploads       Upload[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  role      String
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── System ─────────────────────────────

model Upload {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String   @default("GENERAL")
  path      String   @db.VarChar(500)
  url       String   @db.VarChar(500)
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  module    String
  record    String   @db.Text
  before    String?  @db.Text
  after     String?  @db.Text
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
