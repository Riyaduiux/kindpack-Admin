{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "db:generate": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}