# ─────────────────────────────────────────────────────────────
#  API · server environment
#  Copy to `.env` next to docker-compose.yml and fill in the values.
#  This file is read by docker compose; never commit the real .env.
# ─────────────────────────────────────────────────────────────

# Public URL of the API (used for uploaded file links).
PUBLIC_URL=https://api.example.com
# Host port the API is published on (put a HTTPS reverse proxy in front of it).
API_PORT=8080
# Comma-separated origins allowed to call the API from a browser (the admin dashboard).
CORS_ORIGINS=https://admin.example.com

# ── Database (docker compose builds DATABASE_URL from these) ──
MYSQL_DATABASE=app
MYSQL_USER=app
# Use letters and digits only (or URL-encode special characters).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Without Docker (CloudPanel Node.js site + PM2) ──
# Set these directly instead of the MYSQL_* values above.
# DATABASE_URL=mysql://db_user:db_password@127.0.0.1:3306/db_name
# PORT=3000                                  # the "App Port" of the CloudPanel site
# NODE_ENV=production
# UPLOAD_DIR=/home/<site-user>/uploads       # outside the repo so deploys never touch it

# ── Auth ──
# Long random secret, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Email (password resets, notifications). Without SMTP_HOST emails are only logged. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=App <no-reply@example.com>

# Load the seed data on first start (only when the database is empty).
SEED_ON_START=true
# First admin account created by the seed (change the password after the first login).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
